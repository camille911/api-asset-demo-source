# 复制为 .env 并填入真实值；不要把 .env 提交到 Git。
# 敏感信息只通过环境变量传入，绝不写入 config 文件、日志或数据库。

GITHUB_TOKEN=
GITHUB_REPOSITORY=https://github.com/<owner>/<repo>.git
GITHUB_REF=main
DATA_DIR=./data
GENERATED_DIR=./generated
LOG_DIR=./logs

# RAG 语义检索（可选）
# RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_MODELS_DIR=

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
